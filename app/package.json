{
  "name": "mistake-practice-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "packages/core"
  ],
  "scripts": {
    "dev": "npm run tauri --workspace @mistake-agent/desktop -- dev",
    "build": "npm run build --workspace @mistake-agent/desktop",
    "desktop:build": "npm run prepare:runtime && npm run tauri --workspace @mistake-agent/desktop -- build --no-bundle",
    "desktop:build:debug": "npm run prepare:runtime && npm run tauri --workspace @mistake-agent/desktop -- build --debug --no-bundle",
    "test": "npm run typecheck --workspace @mistake-agent/desktop && node --test ../tests/test_core.mjs ../tests/test_knowledge.mjs ../tests/test_agent.mjs ../tests/test_pdf.mjs ../tests/test_practice_storage.mjs ../tests/test_deepseek.mjs ../tests/test_paper_recognition.mjs ../tests/test_prepare_paper.mjs ../tests/test_workflow.mjs ../tests/test_workflow_cloud.mjs",
    "test:workflow": "npm run typecheck --workspace @mistake-agent/desktop && node --test ../tests/test_workflow.mjs ../tests/test_workflow_cloud.mjs",
    "workflow:demo": "node ../tools/run_workflow_demo.mjs",
    "prepare:runtime": "powershell -NoProfile -File apps/desktop/scripts/prepare-runtime.ps1"
  }
}
